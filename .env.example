# Belle — plantilla de variables de entorno.
# Copia este archivo a `.env` y rellena cada clave con tu valor real.
# El archivo `.env` NO se sube a git (está en .gitignore).

# --- Groq (STT Whisper + LLM LLaMA) ---
GROQ_API_KEY=

# --- ElevenLabs (TTS, voz de Belle) ---
ELEVENLABS_API_KEY=

# --- Google Gemini (visión: descripción de fotos y detección de caídas) ---
GEMINI_API_KEY=

# --- Telegram (bot para familiares) ---
TELEGRAM_BOT_TOKEN=

# --- WeatherAPI (parte meteorológico) ---
WEATHER_API_KEY=
